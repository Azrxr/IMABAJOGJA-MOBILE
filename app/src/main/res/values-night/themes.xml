<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 🌈 Warna Brand -->

        <item name="colorPrimary">@color/maroon_primary_dark</item>
        <item name="colorPrimaryVariant">@color/maroon_primary_variant_dark</item>
        <item name="colorOnPrimary">@color/maroon_on_primary_dark</item>
        <item name="colorSecondary">@color/maroon_secondary_dark</item>
        <item name="colorOnSecondary">@color/maroon_on_primary_dark</item>
        <item name="windowActionBar">@color/maroon_primary_dark</item>

        <!-- 🎨 Latar & Permukaan -->
        <item name="android:colorBackground">@color/backgroundColor_dark</item>
        <item name="colorSurface">@color/surfaceColor_dark</item>
        <item name="colorOnSurface">@color/textColorPrimary_dark</item>

        <!-- 📝 Teks -->
        <item name="android:textColor">@color/textColorPrimary_dark</item>
        <item name="android:textColorPrimary">@color/textColorPrimary_dark</item>
        <item name="android:textColorSecondary">@color/textColorSecondary_dark</item>

        <!-- ⚠️ Error -->
        <item name="colorError">@color/errorColor_dark</item>

        <!-- 🧱 Status & Navigasi -->
        <item name="android:statusBarColor">@color/maroon_primary_dark</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:navigationBarColor">@android:color/darker_gray</item>
        <!-- Jika ingin status bar icon terang -->
        <!--            <item name="android:windowLightStatusBar">true</item>-->

        <!-- 🔤 Font default jika dibutuhkan -->
        <item name="fontFamily">@font/poppins_regular</item>
    </style>

    <!-- Theme khusus untuk SplashScreen Android 12+ -->
    <style name="Theme.IMABAJogja.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.IMABAJogja</item>
        <item name="windowSplashScreenBackground">@color/maroon_primary_dark</item>
<!--        <item name="android:windowBackground">@drawable/splash_background</item>-->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>

        <!-- Status bar and Nav bar configs -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/maroon_primary_dark</item>
        <item name="android:navigationBarColor">@color/maroon_primary_dark</item>
    </style>

    <style name="Theme.IMABAJogja" parent="Theme.MyApp" />

    <style name="BottomNavText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:layout_marginTop">4dp</item> <!-- 🔥 jarak antara icon dan teks -->
        <item name="android:textSize">12sp</item>
    </style>
    <!-- Style for TextInputLayout -->
    <style name="til" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/blue</item>
        <item name="colorControlNormal">@color/maroon_primary</item>
    </style>

    <!-- Style for TextInputEditText -->
    <style name="edt" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:scrollbars">vertical</item>
        <item name="android:inputType">textMultiLine</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <!-- Text Style. -->
